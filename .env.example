APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_SESSION_TTL_SECONDS=86400
SECRETS_DIR=./secrets
SECRETS_GID=10001
APP_SESSION_SECRET_FILE=/run/secrets/session_secret
# Public URL of the same Digital BAST/TalentOps app, e.g. https://bast.example.com
# Required for signed mobile Attendance / Task Evidence links sent from WhatsApp.
TALENTOPS_PUBLIC_URL=
APP_DATABASE_DSN_FILE=/run/secrets/app_database_dsn
LEGACY_DATABASE_DSN_FILE=/run/secrets/legacy_database_dsn
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_PORT=4200
PREFECT_SERVER_UI_API_URL=http://127.0.0.1:4200/api
PREFECT_API_AUTH_STRING_FILE=/run/secrets/prefect_api_auth
PREFECT_DATABASE_DSN_FILE=/run/secrets/prefect_database_dsn
REDIS_URL_FILE=/run/secrets/redis_url
REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_ACL_FILE=/run/secrets/redis_acl
NOCODB_BASE_URL=https://nocodb.example.com
NOCODB_TOKEN_FILE=/run/secrets/nocodb_token
NOCODB_EMPLOYEE_TABLE_ID=mhwyla9uh1ici8j
NOCODB_DATABASE_DSN_FILE=/run/secrets/nocodb_database_dsn
NOCODB_BASE_ID=pc38r6u1npuq0ul
# Attendance / evidence mapping is not derivable from code; fill with the real
# NocoDB table and column names, otherwise those checks report needs_review.
NOCODB_ATTENDANCE_MAPPING={"table":"Attendance","date_column":"Date","clock_in_column":"Clock_In","clock_out_column":"Clock_Out","evidence_column":"Evidence_Attendance","employee_link_table":"_nc_m2m_Attendance_Employee Data","employee_link_column":"Attendance_id"}
NOCODB_TASK_EVIDENCE_COLUMN=Evidence
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_service_account.json
GOOGLE_IOT_SPREADSHEET_ID=1bzAndOjRR-9GOrB8a2_FD5ayE5uPLLrg7gK4bKcmKbo
GOOGLE_IOT_SHEET_NAME=Master Support Ticket MS
TIMESHEET_WEEKDAY_ACTIVITY=P01-Development
TIMESHEET_WEEKEND_ACTIVITY=L05-Public Holiday
TIMESHEET_IOT_ACTIVITY=P05-Support
TIMESHEET_DEFAULT_PROJECT=MTG/PR/202301/000100-Pamapersada Nusantara-Talent Force Jan-Dec 2026-for PAMA
SQLSERVER_CONNECTION_STRING_FILE=/run/secrets/sqlserver_connection_string
REDMINE_DB_SERVER=JIEPBDSQ403
REDMINE_DB_USERNAME=satupama_pro
REDMINE_DB_PASSWORD_FILE=/run/secrets/redmine_db_password
REDMINE_DB_NAME=DB_SATUPAMA_CIS
OUTBOUND_TIMEOUT_SECONDS=30
DIGITAL_BAST_RUN_CONTEXT_FACTORY=digital_bast.flows.production:create_run_context
DIGITAL_BAST_DISABLED_OPERATIONS=attendance-import

# --- Official Meta WhatsApp Cloud API ---
# Public callback: https://<Digital BAST domain>/webhooks/whatsapp
META_GRAPH_VERSION=v26.0
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
META_WA_DISPLAY_PHONE_NUMBER=
META_WA_PUBLIC_BASE_URL=https://REPLACE_WITH_PUBLIC_DOMAIN
META_WA_ACCESS_TOKEN_FILE=/run/secrets/meta_wa_access_token
META_APP_SECRET_FILE=/run/secrets/meta_app_secret
META_WEBHOOK_VERIFY_TOKEN_FILE=/run/secrets/meta_webhook_verify_token
META_DEFAULT_UTILITY_TEMPLATE=bast_action_required_v1
META_TEMPLATE_LANGUAGE=id
BOT_BRIDGE_BASE_URL=http://meta-wa-gateway:8090
BOT_WORKER_BASE_URL=http://bot-worker:8091
BAST_CLI=digital-bast

