[Unit]
Description=Celerates Digital BAST WhatsApp transport (whatsmeow)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/opt/digital-bast-whatsmeow/current
EnvironmentFile=/etc/digital-bast/whatsmeow.env
ExecStart=/opt/digital-bast-whatsmeow/current/digital-bast-whatsmeow
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

# The process intentionally stays alive on a permanent WhatsApp logout so
# Restart=on-failure does not create a reconnect/pairing loop. The operator
# must inspect /internal/v1/status and logs before pairing again.

[Install]
WantedBy=multi-user.target
