# Template only. Copy to bridge/.env and fill in the blanks.
# bridge/.env is gitignored (verified with git check-ignore) -- the repo is
# public, so never move a real value into this example file.

# --- VPS ingest ---
BAST_INGEST_URL=https://conform-v2-web.celeratesapps.com
# Read from the VPS without printing it:
#   ssh debian@142.44.242.56 'sudo cat /home/debian/script/digital-bast-v2/secrets/sync_ingest_token'
BAST_INGEST_TOKEN=

# How far back every run re-sends. Overlapping on purpose: a re-send is a
# no-op upsert, so a window wider than any plausible outage makes a missed run
# self-healing instead of a silent gap. There is no cursor to corrupt.
# Use a short window (e.g. 2) if this runs on a schedule via --upload-sheet;
# a wide one only for a one-off historical --since backfill.
SYNC_LOOKBACK_DAYS=14

# --- PAMA attendance SQL Server ---
PAMA_SQL_SERVER=jiepsqco423
PAMA_SQL_USER=mobile_user
PAMA_SQL_PASSWORD=
PAMA_SQL_DATABASE=db_pamamobile

# --- Redmine SQL Server ---
REDMINE_DB_SERVER=JIEPBDSQ403
REDMINE_DB_USERNAME=satupama_pro
REDMINE_DB_PASSWORD=
REDMINE_DB_NAME=DB_SATUPAMA_CIS

# --- IoT Google Sheet ---
# Relative to the bridge/ folder; see creds/README.md for how to issue the key.
GOOGLE_APPLICATION_CREDENTIALS=creds/service_account.json
GOOGLE_IOT_SPREADSHEET_ID=1bzAndOjRR-9GOrB8a2_FD5ayE5uPLLrg7gK4bKcmKbo
GOOGLE_IOT_SHEET_NAME=Master Support Ticket MS

# --- Sheets relay (--upload-sheet) ---
# Gets a dump off the PAMA network when it can't reach the VPS at all (SSH
# reset, TLS SNI-blocked -- but Sheets is reachable). A distinct service
# account/sheet from the IoT one above -- a service account has no Drive
# storage quota of its own, so the target sheet must already exist and be
# shared Editor with this service account, not created by it. The VPS-side
# poller (scripts/sheet_replay_poller.py) reads and replays what lands here.
GOOGLE_SHEETS_RELAY_CREDENTIALS=creds/sheets_relay_service_account.json
GOOGLE_SHEETS_RELAY_SHEET_ID=
