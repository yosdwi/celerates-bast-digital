# Copy to bridge/.env on the PAMA Windows PC. Never commit the filled-in copy.

# --- VPS ingest ---
BAST_INGEST_URL=https://conform-v2-stagging.celeratesapps.com
BAST_INGEST_TOKEN=

# How far back each run re-sends. Overlapping on purpose: re-sending is a
# no-op upsert, and a window wider than any plausible outage is what makes a
# missed run self-healing instead of a silent gap.
SYNC_LOOKBACK_DAYS=14

# --- PAMA attendance SQL Server ---
PAMA_SQL_SERVER=jiepsqco423
PAMA_SQL_USER=
PAMA_SQL_PASSWORD=
PAMA_SQL_DATABASE=db_pamamobile

# --- Redmine SQL Server ---
REDMINE_DB_SERVER=JIEPBDSQ403
REDMINE_DB_USERNAME=
REDMINE_DB_PASSWORD=
REDMINE_DB_NAME=DB_SATUPAMA_CIS

# --- IoT Google Sheet ---
# The previous service-account key is dead (invalid_grant: Invalid JWT
# Signature). Issue a fresh one in the "digital-bast" GCP project and point
# this at the downloaded JSON.
GOOGLE_APPLICATION_CREDENTIALS=C:\digital-bast\service_account.json
GOOGLE_IOT_SPREADSHEET_ID=1bzAndOjRR-9GOrB8a2_FD5ayE5uPLLrg7gK4bKcmKbo
GOOGLE_IOT_SHEET_NAME=Master Support Ticket MS
